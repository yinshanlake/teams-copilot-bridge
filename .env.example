# Public onboarding: your own single-tenant Azure Bot and authenticated webhook.
# Copy to private .env, replace every REPLACE_ value, and never commit that file.
# A Teams manifest ZIP does not run this backend or register the bot.
BRIDGE_TRANSPORT=webhook
TEAMS_APP_ID=REPLACE_WITH_BOT_APPLICATION_GUID
TEAMS_APP_SECRET=REPLACE_WITH_BOT_CLIENT_SECRET_VALUE
TEAMS_TENANT_ID=REPLACE_WITH_YOUR_TENANT_GUID
TEAMS_OWNER_OBJECT_ID=REPLACE_WITH_YOUR_USER_OBJECT_GUID

# Existing absolute paths. This is JSON, so Windows backslashes must be doubled.
BRIDGE_WORKSPACES='[{"id":"local","name":"My workspace","path":"C:\\REPLACE_WITH_ALLOWED_WORKSPACE"}]'
# Each bot gets <root>\bots\<botAppId>\state.json, bridge.lock and native\.
BRIDGE_STATE_DIRECTORY=.bridge
BIND_HOST=127.0.0.1
PORT=3978
# These are Bot service hosts, NOT your tunnel's hostname.
TEAMS_SERVICE_HOSTS=smba.trafficmanager.net,smba.infra.teams.microsoft.com

# Interaction v3: visible Focus target, independently scoped cards and following.
# Automatic following is renewed by an accepted Teams task; explicit Follow has no expiry.
# Mute never cancels replies/receipts for tasks already sent from Teams.
BRIDGE_STATUS_UPDATE_SECONDS=5
BRIDGE_FOLLOW_HOURS=24
# Preview requests are capability-gated. Current webhook/relay remain in Focus.
# auto does not enable unverified thread posting, native quotes or reactions.
BRIDGE_THREADS=auto
BRIDGE_REACTIONS=auto

# Existing-session discovery/history is local and does not start the private SDK.
# Writes require the included endpoint extension in the ORIGINAL compatible host.
COPILOT_APP_SESSIONS=true
COPILOT_APP_ENDPOINT_TIMEOUT_MS=30000
# Defaults: <home>\.copilot\session-state and <home>\.copilot\teams-session-broker.
# The supplied extension uses those defaults; don't move only one side.
# COPILOT_APP_SESSION_STATE_DIRECTORY=C:\REPLACE_WITH_SESSION_STATE_DIRECTORY
# COPILOT_APP_BROKER_DIRECTORY=C:\REPLACE_WITH_BROKER_DIRECTORY
# Optional read-only side-chat relations. Never automatically locates an App DB.
# COPILOT_APP_METADATA_DB=C:\REPLACE_WITH_COMPATIBLE_APP_DATABASE

# Used only for explicit bot-owned SDK operations or !control instructions.
# Existing-session endpoint operations use the original host's identity instead.
COPILOT_AUTH=logged-in-user
# Sign in yourself with npm run login:copilot; inspect models with npm run models.
# COPILOT_DEFAULT_MODEL=REPLACE_WITH_EXACT_CATALOGUE_MODEL_ID
COPILOT_ENABLE_PEERS=false
# COPILOT_PEER_CONFIG_DIRECTORY=C:\REPLACE_WITH_EXPLICIT_SHARED_PROFILE
# COPILOT_CLI_PATH=C:\REPLACE_WITH_COMPATIBLE_INSTALLATION\copilot.exe

# Explicit optional native alternatives; never auto-selected from ambient tokens.
# COPILOT_AUTH=token
# COPILOT_GITHUB_TOKEN=REPLACE_WITH_EXPLICIT_AUTHORIZED_TOKEN
# COPILOT_AUTH=runtime
# COPILOT_RUNTIME_URI=127.0.0.1:5000
# COPILOT_RUNTIME_TOKEN=REPLACE_WITH_EXPLICIT_RUNTIME_CONNECTION_TOKEN

# Optional operator-provided trusted relay INSTEAD of the webhook; see docs/relay.md.
# No shared service/portal is required or supplied by this repository.
# BRIDGE_TRANSPORT=relay
# BRIDGE_RELAY_CONFIG=C:\REPLACE_WITH_PRIVATE_RELAY_CONFIG.json
# BRIDGE_BOT_APP_ID=REPLACE_WITH_BOT_APPLICATION_GUID
# BRIDGE_RELAY_ORIGIN=https://REPLACE_WITH_TRUSTED_RELAY_HOST
# BRIDGE_FORBIDDEN_BOT_IDS=REPLACE_WITH_EXPLICIT_FORBIDDEN_BOT_GUID
